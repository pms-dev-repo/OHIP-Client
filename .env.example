# Copy to .env and supply your own private settings.
OHIP_GATEWAY_URL=https://gateway.example
OHIP_TOKEN_URL=https://gateway.example/oauth/v1/tokens
OHIP_CLIENT_ID=your-client-id
OHIP_CLIENT_SECRET=your-client-secret
OHIP_APP_KEY=your-application-key
OHIP_ENTERPRISE_ID=your-enterprise-id
OHIP_HOTEL_ID=your-hotel-id
OHIP_SCOPE=your-scope
OHIP_AUTH_MODE=client_credentials
# Required only for password authentication:
OHIP_USERNAME=
OHIP_PASSWORD=
OHIP_TIMEOUT=30
# Optional Streaming settings; use your provisioned endpoint and chain code.
OHIP_STREAMING_URL=
OHIP_CHAIN_CODE=
