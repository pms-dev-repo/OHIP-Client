# Copy to eagle-aruba-uat.env locally; never share the completed file.
OHIP_ENVIRONMENT=mtcu11ua
OHIP_ENTERPRISE_ID=EARE
OHIP_HOTEL_ID=EAR
OHIP_AUTH_MODE=client_credentials
OHIP_STREAMING_ENABLED=true
# Obtain the exact UAT URLs, scope and chain code from the authorized portal.
OHIP_GATEWAY_URL=
OHIP_TOKEN_URL=
OHIP_STREAMING_URL=
OHIP_SCOPE=
OHIP_CHAIN_CODE=
OHIP_CLIENT_ID=
OHIP_CLIENT_SECRET=
OHIP_APP_KEY=
OHIP_TIMEOUT=30
